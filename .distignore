# ── Packaging exclusions ────────────────────────────────────────────────
# Files and directories excluded from the distributable ZIP.
# Used by scripts/package.sh via rsync --exclude-from.

# Version control
.git/
.github/

# Internal tooling
.gstack/
.gstack-screenshots/
.context/

# Tests
tests/
test-results/
playwright-report/

# Dependencies (dev-only, not shipped)
node_modules/
vendor/

# Dependency manifests (dev-only)
composer.json
composer.lock
composer.phar
package.json
package-lock.json

# Test config
phpunit.xml
vitest.config.js

# Packaging infrastructure (not runtime)
scripts/
.distignore

# Dev environment
.wp-env.json
content/
.phpunit.result.cache

# Documentation not needed at runtime
CLAUDE.md
TODOS.md

# Previously built ZIPs
promptingpress-*.zip

# Integrity manifest (build artifact, regenerated each package)
integrity-manifest.json

# Hidden files/folders (catch-all)
.*

# Local evidence artifacts (screenshots, captures) kept beside a working tree.
# Not hidden, so the catch-all above does not reach them, and large enough to
# push the zip past its size limit if they are swept in.
evidence/
