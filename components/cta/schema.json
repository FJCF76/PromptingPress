{
  "component": "cta",
  "description": "Call-to-action block with title, optional supporting text, and a button. Two variants: full-width (centered, bg surface) and inline (flex row).",
  "props": {
    "id": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Optional HTML id attribute for anchor linking (e.g. navigation anchors)."
    },
    "title": {
      "type": "string",
      "required": true,
      "description": "CTA headline."
    },
    "title_accent": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Optional exact substring of title to render in an accent color. Must match title exactly (case-sensitive) or it is ignored."
    },
    "eyebrow": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Optional short kicker/label rendered as a pill above the title."
    },
    "text": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Supporting body text below the title."
    },
    "button_text": {
      "type": "string",
      "required": true,
      "description": "Button label."
    },
    "button_url": {
      "type": "string",
      "required": true,
      "description": "Button destination URL."
    },
    "variant": {
      "type": "enum",
      "values": ["full-width", "inline"],
      "required": false,
      "default": "full-width",
      "description": "'full-width' — centered block with surface background. 'inline' — flex row, text left, button right."
    },
    "theme": {
      "type": "enum",
      "values": ["default", "dark", "inverted"],
      "required": false,
      "default": "default",
      "description": "Color theme. 'default' = surface/page background. 'dark' = dark surface. 'inverted' = inverted background for strong contrast. Combines with variant for layout + color."
    },
    "background_image": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Optional background image URL. When set, renders as a CSS background-image with a dark overlay. Text automatically uses light colors for contrast."
    },
    "button_variant": {
      "type": "enum",
      "values": ["primary", "secondary", "outline", "ghost"],
      "required": false,
      "default": "primary",
      "description": "Button style. 'primary' = filled accent (bare .btn). 'secondary' = muted surface fill. 'outline' = accent border, transparent fill. 'ghost' = borderless text button. Set via update_component (a prop, not a style slot)."
    }
  },
  "styling": {
    "root_class": "cta",
    "variant_classes": ["cta--full-width", "cta--inline", "cta--dark", "cta--inverted"],
    "tokens": ["--space-xl", "--space-2xl", "--space-3xl", "--color-surface", "--color-bg-inverted", "--color-accent", "--overlay-bg"],
    "style_slots": {
      "--cta-padding-top": { "type": "length", "default": "var(--space-xl)", "description": "Top padding of the CTA section" },
      "--cta-padding-bottom": { "type": "length", "default": "var(--space-xl)", "description": "Bottom padding of the CTA section" },
      "--cta-bg": { "type": "gradient", "default": "transparent", "description": "Background color or gradient" },
      "--cta-text": { "type": "color", "default": "var(--color-text)", "description": "Title text color" },
      "--cta-title-accent-color": { "type": "color", "default": "var(--color-accent)", "description": "Color of the title_accent substring within the title, if set" },
      "--cta-eyebrow-color": { "type": "color", "default": "var(--color-text)", "description": "Eyebrow pill text color" },
      "--cta-eyebrow-bg": { "type": "color", "default": "var(--color-surface-accent)", "description": "Eyebrow pill background color" },
      "--cta-title-size": { "type": "length", "default": "inherit", "description": "Title font size" },
      "--cta-body-color": { "type": "color", "default": "var(--color-muted)", "description": "Body text color" },
      "--cta-body-size": { "type": "length", "default": "inherit", "description": "Body text font size" },
      "--cta-inner-gap": { "type": "length", "default": "var(--space-lg)", "description": "Gap between inner elements" },
      "--cta-accent": { "type": "color", "default": "var(--color-accent)", "description": "Button background and border color" },
      "--cta-accent-hover": { "type": "color", "default": "var(--color-accent-hover)", "description": "Button hover background color" },
      "--cta-button-bg": { "type": "color", "default": "(varies by button_variant)", "description": "Button background color, independent of --cta-accent. Applies whatever button_variant is set to." },
      "--cta-button-border": { "type": "color", "default": "(varies by button_variant)", "description": "Button border color, independent of --cta-accent." },
      "--cta-button-color": { "type": "color", "default": "(varies by button_variant)", "description": "Button text color, independent of --cta-accent." },
      "--cta-button-hover-bg": { "type": "color", "default": "(varies by button_variant)", "description": "Button hover background color." },
      "--cta-button-hover-border": { "type": "color", "default": "(varies by button_variant)", "description": "Button hover border color." },
      "--cta-button-hover-color": { "type": "color", "default": "(varies by button_variant)", "description": "Button hover text color." },
      "--cta-border-color": { "type": "color", "default": "transparent", "description": "Top and bottom border color" },
      "--cta-border-width": { "type": "length", "default": "0", "description": "Top and bottom border width" },
      "--cta-radius": { "type": "length", "default": "0", "description": "Border radius" },
      "--cta-shadow": { "type": "shadow", "default": "none", "description": "Box shadow of the CTA section (preset var(--shadow-sm|md|lg) or a bounded box-shadow)" },
      "--cta-content-width": { "type": "length", "default": "40rem", "description": "Title max width" },
      "--cta-overlay-bg": { "type": "gradient", "default": "var(--overlay-bg)", "description": "Background image overlay color or gradient (e.g. a transparent-to-dark scrim for text legibility over an image)" },
      "--cta-bg-position": { "type": "position", "default": "center", "description": "background_image focal point" }
    },
    "recipes": {
      "dark-bold": {
        "description": "Bold dark background with light text for high-conversion CTAs",
        "slots": {
          "--cta-bg": "#1a1a2e",
          "--cta-text": "#ffffff",
          "--cta-body-color": "#c8d6e5",
          "--cta-padding-top": "5rem",
          "--cta-padding-bottom": "5rem"
        }
      },
      "accent-framed": {
        "description": "Accent border framing with rounded corners",
        "slots": {
          "--cta-border-color": "#6366f1",
          "--cta-border-width": "3px",
          "--cta-radius": "1rem"
        }
      }
    }
  },
  "safe_to_edit": ["cta.php", "../../assets/css/components.css (COMPONENT: cta section)"],
  "do_not_touch": ["schema.json without updating README.md"]
}
