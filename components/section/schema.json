{
  "component": "section",
  "description": "Generic text section with an optional image. Supports three layout variants: text only, image left, image right.",
  "props": {
    "id": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Optional HTML id attribute for anchor linking (e.g. navigation anchors)."
    },
    "title": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Section heading. Omit to render the body without a heading."
    },
    "body": {
      "type": "string",
      "required": true,
      "description": "HTML body content. Passed through wp_kses_post()."
    },
    "image_url": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Image URL. Required for image-left and image-right layouts; ignored in text-only."
    },
    "image_alt": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Alt text for the image. Use empty string for decorative images."
    },
    "layout": {
      "type": "enum",
      "values": ["text-only", "image-left", "image-right", "centered"],
      "required": false,
      "default": "text-only",
      "description": "Column layout. 'centered' centers text with no image (image_url suppressed). Falls back to text-only if image_url is empty for image layouts."
    },
    "variant": {
      "type": "enum",
      "values": ["default", "dark", "inverted"],
      "required": false,
      "default": "default",
      "description": "Background presentation. 'default' = page background. 'dark' = dark surface. 'inverted' = inverted background for strong contrast. Controls per-section visual rhythm on marketing pages."
    },
    "background_image": {
      "type": "string",
      "required": false,
      "default": "",
      "description": "Optional background image URL. When set, renders as a CSS background-image with a dark overlay for text readability. Combines with any variant. Text automatically uses light colors for contrast."
    }
  },
  "styling": {
    "root_class": "section",
    "variant_classes": ["section--text-only", "section--image-left", "section--image-right", "section--centered", "pp-section--dark", "pp-section--inverted"],
    "tokens": ["--space-xl", "--space-2xl", "--space-3xl", "--color-bg", "--color-bg-inverted", "--overlay-bg"],
    "style_slots": {
      "--section-padding-top": { "type": "length", "default": "var(--space-xl)", "description": "Top padding of the section" },
      "--section-padding-bottom": { "type": "length", "default": "var(--space-xl)", "description": "Bottom padding of the section" },
      "--section-bg": { "type": "color", "default": "transparent", "description": "Background color" },
      "--section-text": { "type": "color", "default": "var(--color-text)", "description": "Content text color" },
      "--section-accent": { "type": "color", "default": "var(--color-accent)", "description": "Link color" },
      "--section-title-size": { "type": "length", "default": "inherit", "description": "Title font size" },
      "--section-title-color": { "type": "color", "default": "var(--color-text)", "description": "Title text color" },
      "--section-body-width": { "type": "length", "default": "42rem", "description": "Max width of the content column" },
      "--section-border-color": { "type": "color", "default": "transparent", "description": "Top and bottom border color" },
      "--section-border-width": { "type": "length", "default": "0", "description": "Top and bottom border width" },
      "--section-radius": { "type": "length", "default": "0", "description": "Border radius" },
      "--section-image-radius": { "type": "length", "default": "var(--radius)", "description": "Image border radius" },
      "--section-overlay-bg": { "type": "color", "default": "var(--overlay-bg)", "description": "Background image overlay color" }
    },
    "recipes": {
      "accent-panel": {
        "description": "Accent-tinted background with subtle border framing",
        "slots": {
          "--section-bg": "#f0f4ff",
          "--section-border-color": "#c8d6e5",
          "--section-border-width": "1px",
          "--section-radius": "1rem"
        }
      },
      "spacious-editorial": {
        "description": "Wide body with generous padding for long-form content",
        "slots": {
          "--section-padding-top": "5rem",
          "--section-padding-bottom": "5rem",
          "--section-body-width": "52rem"
        }
      }
    }
  },
  "safe_to_edit": ["section.php", "../../assets/css/components.css (COMPONENT: section section)"],
  "do_not_touch": ["schema.json without updating README.md"]
}
